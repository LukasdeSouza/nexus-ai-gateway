# Server
SERVER_PORT=8080
ENV=local
SERVER_READ_TIMEOUT_SEC=30
SERVER_WRITE_TIMEOUT_SEC=60
SERVER_IDLE_TIMEOUT_SEC=120

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:password@localhost:5432/nexus?sslmode=disable
DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=5
MIGRATIONS_PATH=migrations

# Cache & Rate Limiting (Redis)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=nexus-gateway-api
METRICS_ENABLED=true
TRACING_ENABLED=true
LOG_LEVEL=debug

# Provider API Keys (BYOK testing / defaults)
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
GEMINI_API_KEY=your_gemini_key_here

# Provider Base URLs (optional overrides)
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_BASE_URL=https://api.anthropic.com
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
